# PoAgent C probe SHA-256 manifest
# Generated by: make sha256
# Format: <sha256sum>  <filename>
# Regenerate after rebuild: make sha256
#
# This file is read by poagent/security/probe_manifest.py to verify
# probe binaries before upload. Update after each build.
#
# Example (replace with actual hashes after build):
# e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  sram_march.elf
# e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  dma_integrity.elf
# e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  bootrom_checksum.elf
# e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  pll_lock.elf
