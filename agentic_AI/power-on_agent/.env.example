# PoAgent Environment Configuration
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic API ────────────────────────────────────────────────────────────
# Required for all LLM-based analysis.
ANTHROPIC_API_KEY=sk-ant-...

# ── Report signing ───────────────────────────────────────────────────────────
# HMAC-SHA-256 signing key for HTML reports [N-PG-02].
# If unset, falls back to /etc/machine-id derivation (less secure).
# POAGENT_SIGNING_KEY=your-32-byte-or-longer-secret-key

# ── SSH credentials (alternative to --ssh-key CLI flag) ─────────────────────
# POAGENT_SSH_KEY_PATH=/home/user/.ssh/id_rsa
# POAGENT_SSH_USER=root
# POAGENT_SSH_PASSWORD=

# ── Default output directory ─────────────────────────────────────────────────
# POAGENT_OUTPUT_DIR=/var/log/poagent

# ── Default model override ───────────────────────────────────────────────────
# POAGENT_MODEL=claude-sonnet-4-6

# ── Keyring service name (for keyring-stored credentials) ───────────────────
# POAGENT_KEYRING_SERVICE=poagent

# ── Log level ────────────────────────────────────────────────────────────────
# POAGENT_LOG_LEVEL=INFO
